# Ambiente
ENVIRONMENT=development

# POOL DE CREDENCIAIS: qualquer *_API_KEY aceita VÁRIAS chaves por vírgula
# (ex.: GEMINI_API_KEY=chave1,chave2,chave3). O provider rotaciona (round-robin)
# e pula pra próxima quando uma bate cota — 3 chaves grátis ≈ 3x a cota.

# LLM (Groq). Sem essa chave, o app sobe em modo demo com FallbackProvider.
GROQ_API_KEY=
GROQ_MODELS=
GROQ_PLANNER_MODELS=

# ChatGPT Codex usa OAuth do CLI oficial (`codex login`), não API key.
# Opcional: caminho/nome alternativo do executável e ordem de modelos.
CODEX_BINARY=codex
CHATGPT_CODEX_MODELS=

# Gemini (Google AI) como fallback do Groq. Se o Groq falhar (ou não tiver
# chave), cai para o Gemini; sem nenhum dos dois, usa o FallbackProvider demo.
GEMINI_API_KEY=
GEMINI_MODELS=

# OpenRouter como opção de fallback (modelos free).
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# --- Seleção Reforçado (identificador legado: ultra) ---
# Quando o usuário escolhe "Reforçado" na UI, TODA solicitação começa
# pelo modelo mais forte (ULTRA_MODEL). Em timeout/erro/crédito esgotado, cai
# automaticamente na cadeia normal (fallback transparente). Sem API_KEY_ULTRA,
# a tentativa falha e o Router assume. ULTRA_MODEL aceita CSV (tenta na ordem).
API_KEY_ULTRA=
ULTRA_MODEL=
# Vazios usam modelo e endpoint declarados no YAML (OpenRouter por padrão).
ULTRA_BASE_URL=

# --- Seleção Dedicado (identificador legado: ultra_max) ---
# Usa um modelo fixo (deepseek-v4-pro), sem fallback para o Router. Separado do Reforçado de
# propósito, pra não confundir os dois. Basta setar ULTRA_MAX_MODEL — a chave e o
# endpoint reusam os do Ultra (API_KEY_ULTRA / ULTRA_BASE_URL) quando os campos
# _ULTRA_MAX_ abaixo ficam vazios (mesma conta OpenRouter, só o modelo muda).
ULTRA_MAX_MODEL=
# Opcionais — só preencha se quiser uma chave/endpoint DIFERENTE do Ultra:
API_KEY_ULTRA_MAX=
ULTRA_MAX_BASE_URL=

# --- Provedores extras OpenAI-compatible (multi-provider) ---
# Todos falam o formato OpenAI Chat Completions; URLs, custo e prioridade ficam
# em sentury/plugins/robinbandit/config/sentury.yaml. Preencha chave + modelos (CSV).
# Sem chave, o provedor simplesmente não entra na cadeia. Entram como fallback
# ANTES do demo — ampliam o runway gratuito quando Groq/Gemini batem cota.
GITHUB_MODELS_API_KEY=
GITHUB_MODELS_MODELS=
CEREBRAS_API_KEY=
CEREBRAS_MODELS=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODELS=
SAMBANOVA_API_KEY=
SAMBANOVA_MODELS=
MISTRAL_API_KEY=
MISTRAL_MODELS=
COHERE_API_KEY=
COHERE_MODELS=
# Tier 3 (pay-per-use com crédito): DeepInfra e Fireworks (OpenAI-compatible).
DEEPINFRA_API_KEY=
DEEPINFRA_MODELS=
FIREWORKS_API_KEY=
FIREWORKS_MODELS=
ANTHROPIC_API_KEY=
CLAUDE_MODELS=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=ollama
OLLAMA_MODELS=

# Cofre e configuração de contas do RobinBandit. Em container, aponte para um
# volume persistente. Vazios usam .sentury/cofre.json e .sentury/contas.json.
SENTURY_VAULT_PATH=
SENTURY_ACCOUNTS_PATH=

# Volume e seed do dataset de demonstração do setor de CX, que mora em
# memória (pandas).
SENTURY_MOCK_SEED=42
SENTURY_MOCK_FEEDBACKS=5000
SENTURY_MOCK_TICKETS=15000
SENTURY_MOCK_TECHNICIANS=150

# Memória local durável é o padrão: journal append-only + catálogo SQLite em
# SENTURY_HOME (vazio = ~/.sentury). "memory" é um modo efêmero para testes.
SENTURY_HOME=
SENTURY_SESSION_BACKEND=local
SESSION_TTL_SEC=1800
SENTURY_SESSION_ARCHIVE_TTL=2592000
SENTURY_SESSION_MAX_INDEX=80
SENTURY_SESSION_AI_TITLES=true

# Token servidor-para-servidor opcional.
SENTURY_API_TOKEN=

# CSV de origens permitidas, ou "*" para qualquer origem.
CORS_ORIGINS=*

# Gráfico do setor CX pelo QuickChart.io, serviço de fora: os dados do gráfico
# saem da máquina. Desligado (padrão), o gráfico é desenhado localmente.
SENTURY_QUICKCHART=false

# RAG do glossário CX/Ops (o que é NLS, CSAT, SLA, etc.). Por padrão (false)
# usa recuperação léxica em memória. true liga fastembed local; quando Gemini
# embeddings também estiver ligado, o fastembed vira fallback local opcional.
SENTURY_EMBEDDINGS=false

# RAG com embeddings da API Gemini (cota SEPARADA da de chat, 1K RPD). Opt-in;
# melhora a busca semântica do glossário sem instalar nada. Fallback:
# fastembed (se SENTURY_EMBEDDINGS=true) ou léxico.
SENTURY_GEMINI_EMBEDDINGS=false
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Aprendizado pós-chat: roda após CADA mensagem, em background, com chamadas
# LLM extras. true = aprende; false = economiza cota (bom pra demo).
SENTURY_AUTOLEARN=true


# Índice local e progressivo das tools/skills vivas para orientar o Planner.
# Não chama LLM, não escreve respostas e não substitui a policy do Harness.
SENTURY_PROGRESSIVE_CAPABILITIES=true

# Perfil do classificador LLM. CSV provider:model; vazio usa um modelo leve sem
# reasoning/think quando suportado pelo provider.
SENTURY_CLASSIFY_MODELS=

# Prompt Context Engine: carrega SOUL.md e playbooks editaveis sobre os
# guardrails do core. DIR vazio usa sentury/context. Os arquivos recarregam ao
# mudar, sem reiniciar o servidor.
SENTURY_PROMPT_CONTEXT_ENABLED=true
SENTURY_PROMPT_CONTEXT_DIR=
SENTURY_PROMPT_CONTEXT_MAX_CHARS=12000

# Subagentes Beta, opt-in por mensagem: so rodam quando o usuario pede
# explicitamente por subagentes/task agents. Filhos nao recebem ferramentas,
# memoria nem permissao para delegar novamente.
SENTURY_SUBAGENTS_BETA=true
SENTURY_SUBAGENTS_DEFAULT=2
SENTURY_SUBAGENTS_MAX=3
SENTURY_SUBAGENT_TIMEOUT_SEC=35
SENTURY_SUBAGENT_CONTEXT_CHARS=12000
SENTURY_SUBAGENT_SUMMARY_CHARS=2400

# Pasta onde os exports (xlsx/csv/pdf) são gravados em disco, além de irem em
# base64 na resposta do /chat.
SENTURY_EXPORT_DIR=/tmp/sentury-intelligence-exports

# Telegram — mesmo agente atendendo no bot (versão adaptada; painel é o completo).
# TOKEN via @BotFather. TELEGRAM_BOT_ACTIVE=true liga o polling no startup.
# TELEGRAM_ALLOWED_IDS = CSV de chat_ids autorizados (vazio = todos).
TELEGRAM_TOKEN=
TELEGRAM_BOT_ACTIVE=false
TELEGRAM_ALLOWED_IDS=
# O Router do Sentury é o projeto completo em sentury/plugins/robinbandit.
SENTURY_ROBINBANDIT_CONFIG=sentury/plugins/robinbandit/config/sentury.yaml
